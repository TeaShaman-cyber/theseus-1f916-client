#!/bin/sh
set -eu

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
    printf '%s\n' 'property-test: not inside a Git worktree' >&2
    exit 2
}
cd "$ROOT" || exit 2

export PYTHONPATH="${PYTHONPATH:+$PYTHONPATH:}$ROOT"
export HYPOTHESIS_STORAGE_DIRECTORY="${RUNNER_TEMP:-/tmp}/hypothesis-storage"

python -m unittest discover -s property_tests -p 'test_*.py' -v
printf '%s\n' 'PROPERTY_TEST_PASS suite=state-machines max_examples=250 properties=8'
